# Configuración del Servidor
PORT=4000

# Base de Datos NoSQL (MongoDB Atlas o Filess.io Cloud)
MONGODB_URI=mongodb://usuario:password@host.filess.io:27018/nombre_db?authSource=nombre_db

# Seguridad JWT
JWT_SECRET=reemplazar_por_clave_secreta_de_produccion

# Pasarela de Pagos (Mercado Pago SDK)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000
FRONTEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000